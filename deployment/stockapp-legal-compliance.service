[Unit]
Description=AIQ Intellus Legal Compliance Job
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/stockapp/current
EnvironmentFile=/opt/stockapp/.env
ExecStart=/opt/stockapp/.venv/bin/python /opt/stockapp/current/integration/legal-compliance-job.py
Nice=10
